# ----------------------------------------------------------------------------
# DevCart environment configuration.
# Copy to `.env` and fill in real values. Required variables are validated at
# startup by lib/env.ts — a missing value fails fast (build/start), not at runtime.
# ----------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# Production / dev runtime DB is reached through Prisma Accelerate.
DATABASE_URL=prisma+postgres://accelerate.prisma-data.net/?api_key=YOUR_ACCELERATE_KEY

# --- Auth -------------------------------------------------------------------
# Used for session encryption; also the fallback signing secret for cursors.
AUTH_SECRET=generate-a-long-random-string
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Rate limiting (Upstash Redis) ------------------------------------------
UPSTASH_REDIS_REST_URL=https://YOUR_ID.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR_REDIS_TOKEN

# --- Cloudflare R2 (S3-compatible) ------------------------------------------
R2_ACCOUNT_ID=YOUR_R2_ACCOUNT_ID
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_KEY
R2_PUBLIC_BUCKET=YOUR_PUBLIC_BUCKET
R2_PRIVATE_BUCKET=YOUR_PRIVATE_BUCKET

# Public host for cover images (public bucket).
NEXT_PUBLIC_IMAGE_HOST=https://YOUR_BUCKET.r2.dev

# --- Stripe -----------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- App --------------------------------------------------------------------
# Used for Stripe redirect URLs and image URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Sentry -----------------------------------------------------------------
SENTRY_AUTH_TOKEN=

# --- Optional: cursor signing -----------------------------------------------
# If unset, AUTH_SECRET is used. Set this to a distinct secret to rotate cursor
# signing without invalidating sessions.
CURSOR_SECRET=

# --- Optional: dev-only endpoints -------------------------------------------
# Guards POST /api/dev/touch (churn benchmark helper). No value = endpoint 404s.
ADMIN_SECRET=

# --- Optional: data tooling (LOCAL DOCKER ONLY — see docs/ARCHITECTURE.md) ---
# These are hard-guarded to localhost; they will never target the cloud DB.
# TEST_DATABASE_URL is used by the integration suite; SEED_DATABASE_URL by the
# seeder/benchmark. Both default to postgresql://postgres:postgres@localhost:5432/devcart_test.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/devcart_test
SEED_DATABASE_URL=

# Seeder knobs
SEED_COUNT=200000
SEED_SELLERS=200
SEED_MODE=copy          # copy | batch | bench
SEED_CHUNK_COPY=1000    # rows per COPY write
SEED_CHUNK_BATCH=2000   # rows per createMany batch
SEED_CHUNK_DELAY_MS=0   # optional pause between chunks

# Benchmark knobs
BENCH_DEPTH=150000
BENCH_SAMPLES=20
